{% for File in LocalResults %}

    <div class="tli-link-file-result border-bottom py-2 px-1"
         data-file-url="{{ File.url }}"
         data-file-title="{{ File.title|e('html_attr') }}">

        <div class="d-flex gap-2 align-items-start mb-1">
            <div class="flex-shrink-0 pt-1">
                <i class="fa-solid fa-download fa-2xl" style="color: #A3BF60;"></i>
            </div>
            <div>
                <div class="fs-5 fw-bold">
                    <a href="{{ File.url }}" target="_blank" class="text-decoration-none">{{ File.title }}</a>
                </div>
                <div class="text-muted" style="font-size: 0.75rem;">
                    <i class="fa-solid fa-user-tie"></i> a cura di:
                    {% for Author in File.Authors %}
                        <a href="{{ Author.url }}" target="_blank" class="text-muted">{{ Author.username }}</a>{% if not loop.last %}, {% endif %}
                    {% else %}
                        <em>&lt;sconosciuto&gt;</em>
                    {% endfor %}
                    {% if File.format is not empty %}
                        <span class="mx-1"></span>
                        Formato: <code>{{ File.format }}</code>
                    {% endif %}
                    {% if File.sizeLabel is not empty %}
                        <span class="mx-1"></span> {{ File.sizeLabel }}
                    {% endif %}
                    {% if File.views > 0 %}
                        <span class="mx-1"></span>
                        <i class="fa-solid fa-flask-vial"></i>
                        Scaricato {{ File.views }} {% if File.views == 1 %}volta{% else %}volte{% endif %}
                    {% endif %}
                    {% if File.updatedAt %}
                        <span class="mx-1"></span>
                        <i class="fa-regular fa-clock"></i> Ultimo aggiornamento: {{ File.updatedAt|friendlyDate }}
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {% if Replaceable is defined and Replaceable %}
                {% if File.isEditable %}
                    <button type="button" class="btn btn-sm btn-outline-primary tli-link-file-replace">
                        <i class="fa-solid fa-arrows-rotate"></i> È una nuova versione: sostituisci
                    </button>
                {% endif %}
            {% else %}
                <button type="button" class="btn btn-sm border tli-link-file-insert-link">
                    <i class="fa-solid fa-link"></i> Usa come link sul testo
                </button>
                <button type="button" class="btn btn-sm border tli-link-file-insert-download">
                    <i class="fa-solid fa-arrow-right"></i> Usa come riga » Download: ...
                </button>
            {% endif %}
        </div>

        {% if Replaceable is defined and Replaceable and File.isEditable %}
            {% set OtherArticles = File.Articles|filter((OtherArticle, articleId) => articleId != ArticleId) %}
            <div class="tli-link-file-replace-confirm alert alert-warning small mt-2 mb-0 d-none"
                 data-replace-url="{{ path('app_file_edit-replace', {'fileId': File.id}) }}?articleId={{ ArticleId }}">
                <p class="mb-1">
                    «{{ File.title }}» avrà la nuova versione al posto della vecchia, che verrà eliminata.
                    ID e indirizzo restano gli stessi: ogni link al Download, ovunque sia, scaricherà la nuova versione.
                </p>
                {% if OtherArticles is not empty %}
                    <p class="mb-1">Vale anche per:</p>
                    <ul class="mb-2">
                        {% for OtherArticle in OtherArticles %}
                            <li>
                                {% if OtherArticle.isReadable %}
                                    <a href="{{ OtherArticle.url }}" target="_blank">{{ OtherArticle.title }}</a>
                                {% else %}
                                    {{ OtherArticle.title }}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary tli-link-file-replace-cancel">Annulla</button>
                    <button type="button" class="btn btn-sm btn-primary tli-link-file-replace-ok">
                        <i class="fa-solid fa-arrows-rotate"></i> Sì, sostituisci e inserisci nell'articolo
                    </button>
                </div>
                <div class="tli-link-file-replace-error text-danger mt-2"></div>
            </div>
        {% endif %}
    </div>

{% else %}

    <p class="alert alert-warning"> 🪹 Nessun risultato.</p>

{% endfor %}
