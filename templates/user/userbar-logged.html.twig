{% extends 'user/userbar-base.html.twig' %}

{% block userbarContent %}

    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid px-0">

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".tli-userbar-links">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse tli-userbar-links">
                <ul class="navbar-nav w-100 d-flex justify-content-between">
                    <li class="nav-item">
                        <i class="fa-solid fa-user"></i> Ciao <strong>{{ User.username }}!</strong>
                    </li>
                    <li class="nav-item">
                        <a href="{{ newsletterUrl }}">
                            <i class="fa-solid fa-envelope-open-text"></i> Iscrizione newsletter
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ ucpUrl }}">
                            <i class="fa-solid fa-sliders"></i> Pannello di controllo utente
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_article_new') }}"><i class="fa-solid fa-pen"></i> Scrivi nuovo articolo</a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ User.url }}"><i class="fa-solid fa-list"></i> La tua pagina di Autore</a>
                    </li>
                    <li class="nav-item">
                        <form method="post" action="{{ path('app_logout') }}" class="tli-user-logout d-inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button type="submit" class="btn btn-link p-0 border-0 align-baseline">
                                <i class="fa-solid fa-person-walking-dashed-line-arrow-right"></i> Esci (logout)
                            </button>
                        </form>
                    </li>
                </ul>
            </div>

        </div>
    </nav>

{% endblock %}
