<div class="modal-body">

    <form id="tli-edit-file" action="{{ path('app_editor_file_update', {'fileId': File.id, 'articleId': Article.id}) }}" method="POST">
        <div class="mb-3">
            <label for="tli-file-title" class="form-label">
                {% if File.isLocal %}Titolo (sarà anche il nome del file scaricato){% else %}Titolo (nome leggibile){% endif %}
            </label>
            <input type="text" name="title" id="tli-file-title" class="form-control" value="{{ File.title }}" required
                   maxlength="{{ constant('App\\Entity\\Cms\\Article::TITLE_MAX_LENGTH') }}">
        </div>

        <div class="mb-3">
            <label for="tli-file-format" class="form-label">Formato del file</label>
            <select name="format" id="tli-file-format" class="form-select" required>
                <option disabled>Seleziona il formato</option>
                {% for value,Item in Formats %}
                    <option value="{{ value }}" {% if value == File.format %}selected{% endif %}
                        {% if Item.externalOnly and File.isLocal %}class="external-only d-none"{% endif %}>
                        {% if Item.top %}📌 {% endif %}{{ Item.label }}
                    </option>
                {% endfor %}
                <option>❓ Altro (non in lista)</option>
            </select>
            <div class="form-text">
                ❓ Se il formato che desideri non è presente, seleziona <code>Altro (non in lista)</code>
                e poi <a href="/49">segnala il problema</a>.
            </div>
            {% if File.isExternal %}
                <div class="form-text">🛍️ Se il file è ospitato da un "app store", selezionalo dalla lista.</div>
            {% endif %}
        </div>
        <div class="alert alert-danger tli-file-error tli-edit-file-error d-none"></div>

    </form>

    {% set OtherArticles = File.Articles|filter((OtherArticle, articleId) => articleId != Article.id) %}

    {# a new version: same ID, same address, every link follows. The frontend handles the source and the request #}
    <div class="tli-file-replace border-top pt-3"
         data-replace-url="{{ path('app_file_edit-replace', {'fileId': File.id}) }}?articleId={{ Article.id }}">

        <h6><i class="fa-solid fa-arrows-rotate"></i> Sostituisci con una nuova versione</h6>

        <div class="input-group">
            <input type="text" class="form-control tli-file-replace-url"
                   placeholder="Incolla il nuovo URL, oppure scegli o trascina qui il nuovo file">
            <button class="btn btn-outline-primary tli-file-replace-pick" type="button">
                <i class="fa-solid fa-upload"></i> Scegli file...
            </button>
        </div>
        <input type="file" class="d-none tli-file-replace-input">
        <div class="form-text">
            Il Download resta lo stesso, con lo stesso indirizzo: ogni link, in tutti gli articoli, scaricherà la nuova versione.
            {% if File.isLocal %}Il file attuale verrà eliminato.{% endif %}
        </div>

        <div class="tli-file-replace-confirm d-none mt-2 p-3 border border-2 border-danger rounded bg-danger-subtle">

            <p class="mb-2 text-danger-emphasis">
                <strong>«{{ File.title }}»</strong> sarà sostituito da <strong class="tli-file-replace-source-name text-break"></strong>
                {% if OtherArticles is empty %}
                    in questo articolo.
                {% else %}
                    in questo articolo e
                    {% if OtherArticles|length == 1 %}nell'altro articolo che lo usa:{% else %}negli altri {{ OtherArticles|length }} articoli che lo usano:{% endif %}
                {% endif %}
            </p>

            {% if OtherArticles is not empty %}
                <ul class="mb-2">
                    {% for OtherArticle in OtherArticles %}
                        {# the title is masked where the viewer can't list the article: link only what they can open #}
                        <li>
                            {% if OtherArticle.isReadable %}
                                <a href="{{ OtherArticle.url }}" target="_blank">{{ OtherArticle.title }}</a>
                            {% else %}
                                {{ OtherArticle.title }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <p class="tli-file-error tli-file-replace-error alert alert-danger d-none"></p>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary tli-file-replace-cancel">Annulla</button>
                <button type="button" class="btn btn-sm btn-danger tli-file-replace-ok">
                    <i class="fa-solid fa-arrows-rotate"></i> Sì, sostituisci
                </button>
            </div>
        </div>

    </div>

</div>

<div class="modal-footer">
    <button type="submit" form="tli-edit-file" class="btn btn-success tli-file-button-ok">Salva modifiche</button>
    <button type="button" class="btn btn-secondary tli-file-button-cancel" data-bs-dismiss="modal">Annulla</button>
</div>
