{% extends 'base.html.twig' %}

{% block metaRobots %}noindex,follow{% endblock %}

{% block stylesheets %}

    {{ parent() }}
    {{ inline_css('build/checks.css') }}

{% endblock %}


{% block bodyMainContent %}

    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="about-author-content mt-10">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                            <li class="breadcrumb-item"><i class="fa-solid fa-pen"></i> <a href="{{ path('app_article_new') }}">Nuovo articolo</a></li>
                            <li class="breadcrumb-item"><i class="fa-solid fa-images"></i> Immagini orfane</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>


    <div class="container tli-checks">

    {% if CurrentUser %}

        {% if Images is not empty %}
        <section class="tli-check">
            <h1 class="tli-check-title">
                <i class="fa-solid fa-images"></i>
                Immagini orfane <span class="tli-check-count">{{ num }}</span>
            </h1>
            <p>
                Le seguenti immagini non sono utilizzate da alcun articolo, e saranno presto cancellate automaticamente.
                Per evitare che questo accada, inseriscile nel testo di un articolo, oppure
                salva una copia dell'immagine che vuoi conservare sul tuo PC.
            </p>
            <ul class="tli-check-images">
                {% for Image in Images %}
                    <li>
                        <a href="{{ Image.url(ImageSizes.max) }}" target="_blank">
                            <img src="{{ Image.url(ImageSizes.reg) }}" alt="{{ Image.title }}" loading="lazy">
                        </a>
                        <span class="tli-check-image-title" title="{{ Image.title }}">{{ Image.title }}</span>
                        <span class="tli-check-image-meta">
                            #{{ Image.id }}
                            {%- for Author in Image.Authors %}
                                {{- loop.first ? ' · ' : ', ' }}<a href="{{ path('app_author', {'usernameClean': Author.usernameClean}) }}">{{ Author.username }}</a>
                            {%- endfor %}
                        </span>
                        {% set DeletionDate = Image.orphanDeletionDate %}
                        <span class="tli-check-image-deletion{% if DeletionDate < date('+30 days') %} tli-check-image-deletion-soon{% endif %}">
                            <i class="fa-regular fa-trash-can"></i>
                            Cancellazione:
                            <span class="text-nowrap">{{ DeletionDate > date() ? DeletionDate|format_datetime(locale='it', pattern='d MMM y') : 'a breve' }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <section class="tli-check tli-check-passed">
            <h1 class="tli-check-title">
                <i class="fa-solid fa-circle-check"></i>
                Immagini orfane
            </h1>
            <ul>
                <li><i class="fa-solid fa-check"></i> <strong>Zero "Immagini orfane"</strong>&nbsp;- ogni immagine è utilizzata almeno in un articolo</li>
            </ul>
        </section>
        {% endif %}

    {% else %}

        <section class="tli-check">
            <h1 class="tli-check-title">Immagini orfane</h1>
            <p>Per visualizzare le immagini orfane devi eseguire login.</p>
            {% include 'user/login-form.html.twig' %}
        </section>

    {% endif %}


        <section class="tli-check tli-check-resources">
            <h2 class="tli-check-title">Altre risorse per gli autori</h2>
            <p>
                <i class="fa-solid fa-file-half-dashed"></i>
                <a href="{{ path('app_file_need-fixing') }}">File da controllare</a>
            </p>
        </section>

    </div>

{% endblock %}
